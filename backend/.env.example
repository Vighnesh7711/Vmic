# Vmic — Backend environment variables (example)
# Copy to .env and adjust for your machine. Do NOT commit the real .env.

# Redis (state store) — audio NEVER flows through Redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# FastAPI server bind address / port.
HOST=0.0.0.0
PORT=8000

# Allowed browser origin for CORS (the Next.js dev server).
FRONTEND_ORIGIN=http://localhost:3000
